+#if defined(ESP32) && CAP_BATTERY
+// Keep wifiConfig's battery hold in sync with power source + the Settings pref.
+// announce: toast when the hold newly engages / clears (Settings toggle path).
+static void wifiOffOnBatteryTick(bool announce) {
+  const bool want = touchPrefsGetWifiOffOnBattery() && tsOnBattery();
+  const bool was = wifiConfigGetBatteryHold();
