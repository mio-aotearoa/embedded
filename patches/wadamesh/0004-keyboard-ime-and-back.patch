+    // Use the chained fallback font first, then append the SD-backed CJK face.
+    // This keeps the existing Latin/Greek/Cyrillic glyphs while allowing the
+    // Japanese and Chinese candidates to render in the bound text field.
+    useChainedFont(ta);
+    imeFontAttachFallback(const_cast<lv_font_t*>(
+        lv_obj_get_style_text_font(ta, LV_PART_MAIN)));
+    lv_obj_add_state(ta, LV_STATE_FOCUSED);
+  }
+}
