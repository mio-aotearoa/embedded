+void appPageBindTextField(lv_obj_t* ta) {
+  if (ta && !lv_obj_is_valid(ta)) ta = nullptr;
+  if (s_page_text_field && s_page_text_field != ta && lv_obj_is_valid(s_page_text_field))
+    lv_obj_clear_state(s_page_text_field, LV_STATE_FOCUSED);
+  if (!ta) imeDismissUi();
+  s_page_text_field = ta;
+  if (!g_lv.keyboard) return;
+  // Hidden on purpose: these boards have a real keyboard (see the composer path).
+  lv_obj_add_flag(g_lv.keyboard, LV_OBJ_FLAG_HIDDEN);
