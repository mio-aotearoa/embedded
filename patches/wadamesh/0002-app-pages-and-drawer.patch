+// ---- Kiwix bridge ---------------------------------------------------------
+// firmware/tdeck-plus/kiwix/kiwix_app.cpp writes one ZIM article out as local
+// HTML on the card and calls this. Handing it to the Reader that already ships
+// here means scrolling, keyboard/trackball navigation and the back bar are the
+// firmware's own, not a second document renderer. Declared extern "C" in
+// kiwix_app.cpp so the name does not depend on C++ mangling.
+#if WADAMESH_KIWIX
+// The Reader itself is built when MULTI_TRANSPORT_COMPANION is on (it is on the
+// T-Deck); the guard keeps this file compiling on envs that have no Reader.
+#if defined(ESP32) && defined(MULTI_TRANSPORT_COMPANION)
+extern "C" void wadameshOpenReaderUrl(const char* url) { openReaderPage(url); }
+#endif
+#endif
