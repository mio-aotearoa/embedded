+// S3 shares the S2-class MAC (PWR IRQ + OSI + same MAC init/clock family).
+const ESP32S3_META: &[&str] = &["esp32s3", PWR_INTERRUPT_PRESENT, OSI_FUNCS_REQUIRED];
 
 fn main() {
     let meta = if cfg!(feature = "esp32") {
         ESP32_META
