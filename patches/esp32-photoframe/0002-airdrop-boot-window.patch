+    // --- AirDrop boot window (repository integration) ----------------------
+    // Hold the wake/select button at power-on to receive one AirDrop file
+    // instead of starting Wi-Fi. AWDL owns the 2.4 GHz radio exclusively, so
+    // this runs before wifi_manager_init() claims it.
+#if !CONFIG_AIRDROP_COEX
+    if (airdrop_bridge_boot_requested()) {
+        char airdrop_path[160] = {0};
+        esp_err_t airdrop_err = airdrop_bridge_receive_to_file(
+            airdrop_path, sizeof(airdrop_path), AIRDROP_BRIDGE_WINDOW_MS);
+        if (airdrop_err == ESP_OK) {
+            image_format_t airdrop_format = image_processor_detect_format(airdrop_path);
+            if (airdrop_format == IMAGE_FORMAT_JPG || airdrop_format == IMAGE_FORMAT_PNG) {
+                display_flow_stream_file(airdrop_path, airdrop_format,
+                                         DITHER_FLOYD_STEINBERG, NULL, false);
+                display_flow_retire_source(airdrop_path, airdrop_format, false);
+            } else {
+                ESP_LOGW(TAG, "AirDrop file %s not displayable", airdrop_path);
+            }
+        }
+        power_manager_enter_sleep();
+    }
+#endif
+    // -----------------------------------------------------------------------
+
     ESP_ERROR_CHECK(wifi_manager_init());
     ESP_ERROR_CHECK(wifi_provisioning_init());
 
