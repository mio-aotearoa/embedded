@@ -677,6 +685,30 @@ void app_main(void)
         break;
     }
 
+    // --- AirDrop boot window (repository integration) ----------------------
+    // Hold the wake/select button at power-on to receive one AirDrop file
+    // instead of starting Wi-Fi. AWDL owns the 2.4 GHz radio exclusively, so
+    // this runs before wifi_manager_init() claims it.
+#if !CONFIG_AIRDROP_COEX
+    if (airdrop_bridge_boot_requested()) {
+        char airdrop_path[160] = {0};
+        esp_err_t airdrop_err = airdrop_bridge_receive_to_file(
+            airdrop_path, sizeof(airdrop_path), AIRDROP_BRIDGE_WINDOW_MS);
+        if (airdrop_err == ESP_OK) {
+            image_format_t airdrop_format = image_processor_detect_format(airdrop_path);
+            if (airdrop_format == IMAGE_FORMAT_JPG || airdrop_format == IMAGE_FORMAT_PNG) {
+                display_flow_stream_file(airdrop_path, airdrop_format,
+                                         DITHER_FLOYD_STEINBERG, NULL, false);
+                display_flow_retire_source(airdrop_path, airdrop_format, false);
+            } else {
+                ESP_LOGW(TAG, "AirDrop file %s not displayable", airdrop_path);
+            }
+        }
+        power_manager_enter_sleep();
+    }
+#endif
+    // -----------------------------------------------------------------------
+
     ESP_ERROR_CHECK(wifi_manager_init());
     ESP_ERROR_CHECK(wifi_provisioning_init());
 
@@ -783,11 +815,47 @@ void app_main(void)
         }
     }
 
+#if !CONFIG_AIRDROP_COEX
     xTaskCreate(button_task, "button_task", 8192, NULL, 5, NULL);
-
+#endif
     ESP_ERROR_CHECK(http_server_init());
     http_server_set_ready();
 
+#if CONFIG_AIRDROP_COEX
+    // HTTP stays available while the main task pumps AirDrop. Defer scheduled
+    // downloads and button-driven display work until this bounded experiment ends.
+    wifi_ap_record_t coex_ap;
+    if (s_airdrop_recovery == AIRDROP_RECOVERY_MAGIC) {
+        s_airdrop_recovery = 0;
+        ESP_LOGW(TAG, "Skipping AirDrop once after interrupted coex window; WiFi continues");
+    } else if (wifi_err == ESP_OK && esp_wifi_sta_get_ap_info(&coex_ap) == ESP_OK &&
+        coex_ap.primary == 6) {
+        char path[160] = {0};
+        s_airdrop_recovery = AIRDROP_RECOVERY_MAGIC;
+        power_manager_reset_sleep_timer();
+        esp_err_t err = airdrop_bridge_receive_to_file(
+            path, sizeof(path), AIRDROP_BRIDGE_WINDOW_MS);
+        if (err == ESP_OK) {
+            image_format_t format = image_processor_detect_format(path);
+            if (format == IMAGE_FORMAT_JPG || format == IMAGE_FORMAT_PNG) {
+                display_flow_stream_file(path, format, DITHER_FLOYD_STEINBERG, NULL, false);
+                display_flow_retire_source(path, format, false);
+            }
+        } else {
+            ESP_LOGW(TAG, "Experimental AirDrop window ended: %s", esp_err_to_name(err));
+        }
+        if (airdrop_bridge_is_active()) {
+            ESP_LOGW(TAG, "AWDL cleanup incomplete; rebooting to release the radio safely");
+            esp_restart();
+        }
+        s_airdrop_recovery = 0;
+        if (!wifi_manager_is_connected()) wifi_err = ESP_ERR_TIMEOUT;
+        power_manager_reset_sleep_timer();
+    } else {
+        ESP_LOGW(TAG, "Concurrent AirDrop requires a connected channel-6 router; WiFi continues");
+    }
+    xTaskCreate(button_task, "button_task", 8192, NULL, 5, NULL);
+#endif
     ESP_LOGI(TAG, "PhotoFrame started successfully");
 
     if (wifi_err == ESP_OK) {
