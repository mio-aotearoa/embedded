diff --git a/main/http_server.c b/main/http_server.c
index c808df7..3d29ed1 100644
--- a/main/http_server.c
+++ b/main/http_server.c
@@ -1,4 +1,5 @@
 #include "http_server.h"
+#include "airdrop_bridge.h"
 
 #include <dirent.h>
 #include <errno.h>
@@ -195,6 +196,17 @@ static esp_err_t auth_gate(httpd_req_t *req)
         httpd_resp_sendstr(req, "{\"error\":\"authentication required\"}");
         return ESP_OK;
     }
+#if CONFIG_AIRDROP_COEX
+    // Keep browsing/status available while AWDL owns the receive buffers. Do
+    // not allow an upload, reset, OTA or sleep request to interrupt the window.
+    if (airdrop_bridge_is_active() && req->method != HTTP_GET &&
+        strcmp(req->uri, "/api/keep_alive") != 0) {
+        httpd_resp_set_status(req, "503 Service Unavailable");
+        httpd_resp_set_hdr(req, "Retry-After", "5");
+        httpd_resp_set_type(req, "application/json");
+        return httpd_resp_sendstr(req, "{\"error\":\"AirDrop receive window active; try again shortly\"}");
+    }
+#endif
     return ((http_handler_fn) req->user_ctx)(req);
 }
 
